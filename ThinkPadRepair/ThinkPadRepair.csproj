<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ThreeFingerDrag-ThinkPadRepair</AssemblyName>
    <ApplicationIcon>../ThreeFingerDragOnWindows/Assets/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.7.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ThreeFingerDragOnWindows/touchpad/TouchpadHelper.cs" Link="TouchpadHelper.cs" />
    <Compile Include="../ThreeFingerDragOnWindows/touchpad/TouchpadDeviceInfo.cs" Link="TouchpadDeviceInfo.cs" />
    <Compile Include="../ThreeFingerDragOnWindows/touchpad/HidReportDecoder.cs" Link="HidReportDecoder.cs" />
    <Compile Include="../ThreeFingerDragOnWindows/touchpad/ContactFrameAssembler.cs" Link="ContactFrameAssembler.cs" />
    <Compile Include="../ThreeFingerDragOnWindows/threefingerdrag/*.cs" Link="engine/%(Filename)%(Extension)" />
    <Compile Include="../ThreeFingerDragOnWindows/utils/TouchpadContact.cs" Link="TouchpadContact.cs" />
    <Compile Include="../ThreeFingerDragOnWindows/utils/PointsUtils.cs" Link="Point.cs" />
    <Compile Include="../ThreeFingerDragOnWindows/utils/MouseOperations.cs" Link="MouseOperations.cs" />
  </ItemGroup>
</Project>
